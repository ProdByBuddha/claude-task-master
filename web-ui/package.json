{
  "name": "task-master-web-ui",
  "version": "0.1.0",
  "description": "Web UI for Claude Task Master",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "predev:server": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env') && fs.existsSync('../.env')) fs.copyFileSync('../.env', '.env');\"",
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "dev": "npm run dev:server",
    "build": "vite build",
    "client": "vite",
    "test": "vitest",
    "test-api": "node test-api.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "axios": "^1.6.2",
    "react-query": "^3.39.3",
    "react-icons": "^4.12.0",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.10",
    "vitest": "^1.0.4",
    "nodemon": "^3.0.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
} 